# Production (AWS) settings — copy to .env on the server and fill in

# The top level domain to serve from
DOMAIN_NAME=example.com

# The subdomain to serve from (result: https://n8n.example.com)
SUBDOMAIN=n8n

# Timezone used by Cron and other scheduling nodes
GENERIC_TIMEZONE=Africa/Nairobi

# Keep at most this many hours of execution data (default: 14 days)
EXECUTIONS_DATA_MAX_AGE=336

# Keep at most this many executions in the database
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Email address for Let's Encrypt TLS certificate creation
SSL_EMAIL=admin@example.com

# n8n version — one value for every host, to avoid import/runtime drift
N8N_VERSION=2.25.7

# Publishing queue Postgres. The same schema and SQL work with a Neon Postgres
# credential later.
# PUBLISHING_DB_PASSWORD is REQUIRED with no default, in local development too:
# PUBLISHING_DB_USER is a superuser on that server, and the server sits on
# public-net so the internet-facing n8n instance can reach port 5432. Generate:
#   openssl rand -hex 32
PUBLISHING_DB_NAME=short_videos
PUBLISHING_DB_USER=short_videos
PUBLISHING_DB_PASSWORD=replace-me-openssl-rand-hex-32
PUBLISHING_DB_PORT=5433

# REQUIRED, no default. The heavy n8n task-runner broker listens on all
# interfaces inside its container, so this token is what stands between the
# broker and anything else that reaches heavy-net. It used to carry a committed
# default, which made a network mistake into remote code execution in the
# container that holds every credential. Generate one per host:
#   openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=replace-me-openssl-rand-hex-32

# Heavy host (the video pipeline: shell access, every credential).
# Locally 127.0.0.1. In production set this to the host's Tailscale address so
# the editor is reachable over the tailnet and not from the internet. It has no
# Traefik router on purpose.
HEAVY_BIND_ADDRESS=127.0.0.1
HEAVY_PORT=5678
# Concurrent ffmpeg renders are the thing to avoid on a 4 GB box.
HEAVY_CONCURRENCY=2

# Postgres listener. 127.0.0.1 keeps it off the network entirely.
POSTGRES_BIND_ADDRESS=127.0.0.1

# NOTE on N8N_ENCRYPTION_KEY: the heavy host deliberately sets none. Its key was
# generated on first boot and lives in /home/node/.n8n/config inside the
# n8n_n8n_data volume; setting any value here makes every stored credential
# undecryptable. Read it out of the volume before migrating or rebuilding:
#   docker compose -f hosts/compose.local.yaml exec n8n \
#     sh -c 'cat /home/node/.n8n/config'
# The public host is the opposite case: it has no credentials to lose yet, so it
# pins its own key, required with no default. See hosts/README.md.

# ---------------------------------------------------------------------------
# Public host (webhook-facing, untrusted automations: paid WhatsApp access)
# ---------------------------------------------------------------------------

# REQUIRED, no default, and it MUST differ from heavy's key. heavy sets no key
# at all — see the note above — so there is nothing to copy from. Generate:
#   openssl rand -hex 32
PUBLIC_N8N_ENCRYPTION_KEY=replace-me-openssl-rand-hex-32

PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=5679
# Higher than heavy's: these are small webhooks, not ffmpeg renders.
PUBLIC_CONCURRENCY=5
# n8n defaults to 16 (MB). Payment and WhatsApp webhooks are under 50 KB, and
# this instance is capped at 512 MB of memory.
PUBLIC_PAYLOAD_SIZE_MAX=4

# Publishing this instance to the internet is a deliberate act. Leave false
# until the automation is ready; Traefik has no route to heavy either way.
PUBLIC_TRAEFIK_ENABLE=false
PUBLIC_SUBDOMAIN=automations

# The whatsapp-access domain's own database and role on the shared Postgres
# server. REQUIRED with no default: this role is reachable from the untrusted
# instance. It is created and fenced by hosts/shared/postgres/bootstrap-databases.sh,
# which also caps it at 20 connections so it cannot starve the video queue.
WHATSAPP_DB_NAME=whatsapp_access
WHATSAPP_DB_USER=whatsapp_access
WHATSAPP_DB_PASSWORD=replace-me-openssl-rand-hex-32

# Production (AWS) settings — copy to .env on the server and fill in

# The top level domain to serve from
DOMAIN_NAME=example.com

# The subdomain to serve from (result: https://n8n.example.com)
SUBDOMAIN=n8n

# Timezone used by Cron and other scheduling nodes
GENERIC_TIMEZONE=Africa/Nairobi

# Keep at most this many hours of execution data (default: 14 days)
EXECUTIONS_DATA_MAX_AGE=336

# Keep at most this many executions in the database
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Email address for Let's Encrypt TLS certificate creation
SSL_EMAIL=njihialeon00@gmail.com

# n8n version — keep in sync with compose.local.yaml to avoid import/runtime drift
N8N_VERSION=2.25.7

# Local publishing queue Postgres. Replace the password outside local development.
# The same schema and SQL work with a Neon Postgres credential later.
PUBLISHING_DB_NAME=short_videos
PUBLISHING_DB_USER=short_videos
PUBLISHING_DB_PASSWORD=local-publishing-password-change-me
PUBLISHING_DB_PORT=5433

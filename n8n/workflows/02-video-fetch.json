        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": []
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000012",
      "name": "Append Candidates",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2420,
        20
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst now = new Date().toISOString();\nconst ids = [...new Set(sd.touchedSources || [])];\nsd.touchedSources = [];\nsd.existingIds = {};\nreturn ids.map((id, i) => ({ json: { source_id: id, last_checked_at: now }, pairedItem: { item: i } }));"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000013",
      "name": "Emit Touched Channels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "GOOGLE_SHEETS_DOCUMENT_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Source_Channels"
        },
        "options": {},
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "source_id"
          ]
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000014",
      "name": "Update last_checked_at",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1320,
        -160
      ]
    }
  ],
